@model IReadOnlyList<DealSummaryView>

@if (Model.Count == 0)
{
    <p class="text-muted">Nessun deal.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Deal</th>
                <th>Nome</th>
                <th>Azienda</th>
                <th class="text-end">Importo</th>
                <th>Stage</th>
                <th>Stato O2C</th>
                <th>Ordine ERP</th>
                <th>Aggiornato</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var deal in Model)
            {
                <tr>
                    <td><a asp-page="/Deals/Details" asp-route-dealId="@deal.DealId"><code>@deal.DealId</code></a></td>
                    <td>@deal.Name</td>
                    <td><a asp-page="/Companies/Details" asp-route-companyId="@deal.CompanyId">@deal.CompanyName</a></td>
                    <td class="text-end text-nowrap">@deal.Amount.ToString("N2") @deal.Currency</td>
                    <td><span class="badge @DealPresentation.StageClass(deal.Stage)">@DealPresentation.StageLabel(deal.Stage)</span></td>
                    <td><span class="badge @DealPresentation.StatusClass(deal.O2CStatus)">@DealPresentation.StatusLabel(deal.O2CStatus)</span></td>
                    <td>@(deal.ErpOrderNumber ?? "—")</td>
                    <td class="text-nowrap">@deal.UpdatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
