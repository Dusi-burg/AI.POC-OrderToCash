@page "/customers/{customerId:int}"
@model Dusiburg.AI.O2C.Erp.Web.Pages.Customers.DetailsModel
@{
    var customer = Model.Customer;
    ViewData["Title"] = customer.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">
        @customer.Name <small class="text-muted">id @customer.CustomerId</small>
        @if (customer.IsBlocked)
        {
            <span class="badge text-bg-danger fs-6 align-middle" id="blocked">bloccato</span>
        }
    </h1>
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Customers/Index">Tutti i clienti</a>
</div>

<dl class="row mb-4">
    <dt class="col-sm-2">Partita IVA</dt>
    <dd class="col-sm-10">@(customer.VatNumber ?? "—")</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@customer.Email</dd>

    <dt class="col-sm-2">Indirizzo</dt>
    <dd class="col-sm-10">@customer.Address</dd>

    <dt class="col-sm-2">Fido</dt>
    <dd class="col-sm-10">@customer.CreditLimit.ToString("N2") € <span class="text-muted">(informativo: la policy di approvazione non lo usa)</span></dd>
</dl>

<h2 class="h5">Ordini del cliente</h2>
<partial name="_OrderTable" model="customer.Orders" />
