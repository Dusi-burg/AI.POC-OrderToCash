@using Dusiburg.AI.O2C.ServiceDefaults.Portal
@using Microsoft.Extensions.Options
@inject IOptions<PortalLinks> PortalLinksOptions
@{
    var links = PortalLinksOptions.Value;
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (ViewData["AutoRefreshSeconds"] is int refreshSeconds)
    {
        <meta http-equiv="refresh" content="@refreshSeconds" />
    }
    <title>@ViewData["Title"] - O2C ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dusiburg.AI.O2C.Erp.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">O2C ERP</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Apri il menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-page="/Customers/Index">Clienti</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Stock/Index">Magazzino</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Orders/Index">Ordini</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (links.CrmWeb is { Length: > 0 } crmWeb)
                        {
                            <li class="nav-item"><a class="nav-link" href="@crmWeb">CRM</a></li>
                        }
                        @if (links.ApprovalsWeb is { Length: > 0 } approvalsWeb)
                        {
                            <li class="nav-item"><a class="nav-link" href="@approvalsWeb/approvals">Approvazioni</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Dusiburg.AI.O2C.Erp.Web — ERP della demo Order-to-Cash (sola lettura)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
