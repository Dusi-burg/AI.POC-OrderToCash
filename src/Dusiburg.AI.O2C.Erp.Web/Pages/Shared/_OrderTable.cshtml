@using Dusiburg.AI.O2C.ServiceDefaults.Portal
@using Microsoft.Extensions.Options
@model IReadOnlyList<OrderSummaryView>
@inject IOptions<PortalLinks> PortalLinksOptions

@if (Model.Count == 0)
{
    <p class="text-muted">Nessun ordine ricevuto.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Numero</th>
                <th>Cliente</th>
                <th class="text-end">Totale</th>
                <th>Stato</th>
                <th>Deal</th>
                <th>Ricevuto</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var dealLink = PortalLinksOptions.Value.CrmDeal(order.ExternalRef);
                <tr>
                    <td><a asp-page="/Orders/Details" asp-route-orderNumber="@order.OrderNumber"><code>@order.OrderNumber</code></a></td>
                    <td><a asp-page="/Customers/Details" asp-route-customerId="@order.CustomerId">@order.CustomerName</a></td>
                    <td class="text-end text-nowrap">@order.Total.ToString("N2") €</td>
                    <td><span class="badge @ErpPresentation.OrderStatusClass(order.Status)">@order.Status</span></td>
                    <td>
                        @if (dealLink is not null)
                        {
                            <a href="@dealLink">@order.ExternalRef</a>
                        }
                        else
                        {
                            @order.ExternalRef
                        }
                    </td>
                    <td class="text-nowrap">@order.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
