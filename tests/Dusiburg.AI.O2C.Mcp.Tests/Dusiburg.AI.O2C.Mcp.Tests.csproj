<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Runner NUnit su Microsoft.Testing.Platform, come impostato in global.json -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dusiburg.AI.O2C.Shared\Dusiburg.AI.O2C.Shared.csproj" />
    <ProjectReference Include="..\..\src\Dusiburg.AI.O2C.Crm.Mcp\Dusiburg.AI.O2C.Crm.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Dusiburg.AI.O2C.Erp.Mcp\Dusiburg.AI.O2C.Erp.Mcp.csproj" />
    <!-- Erp.Api reale dietro Erp.Mcp (D36); l'alias distingue il suo Program da quelli dei server MCP -->
    <ProjectReference Include="..\..\src\Dusiburg.AI.O2C.Erp.Api\Dusiburg.AI.O2C.Erp.Api.csproj" Aliases="ErpApi" />
    <!-- Creazione dei database di test dal modello (D30) -->
    <ProjectReference Include="..\..\tools\Dusiburg.AI.O2C.DbInit\Dusiburg.AI.O2C.DbInit.csproj" />
  </ItemGroup>

</Project>
