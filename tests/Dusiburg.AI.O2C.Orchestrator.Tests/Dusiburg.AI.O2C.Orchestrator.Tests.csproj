<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Runner NUnit su Microsoft.Testing.Platform, come impostato in global.json -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- UI e callback delle approvazioni in-process (5.9) -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Helper di Shared e correlazione di ServiceDefaults (test 0.8) -->
    <ProjectReference Include="..\..\src\Dusiburg.AI.O2C.ServiceDefaults\Dusiburg.AI.O2C.ServiceDefaults.csproj" />
    <!-- Agente, guardia e factory del modello (3.8): modello a copione e tool in memoria, nessuna chiamata reale -->
    <ProjectReference Include="..\..\src\Dusiburg.AI.O2C.Orchestrator\Dusiburg.AI.O2C.Orchestrator.csproj" />
    <!-- Coda, dettaglio e callback delle approvazioni (5.9): decisione, nota e 409 sulla seconda decisione -->
    <ProjectReference Include="..\..\src\Dusiburg.AI.O2C.Approvals.Web\Dusiburg.AI.O2C.Approvals.Web.csproj" />
    <!-- Creazione del database di test dal modello, senza migration (D30) -->
    <ProjectReference Include="..\..\tools\Dusiburg.AI.O2C.DbInit\Dusiburg.AI.O2C.DbInit.csproj" />
  </ItemGroup>

</Project>
